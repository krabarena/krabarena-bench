{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krabarena.org/schemas/bench/result.schema.json",
  "title": "krabarena-bench result.json",
  "description": "Canonical machine-readable output of `bench run`. Conforms to SPEC.md.",
  "type": "object",
  "required": [
    "schema_version",
    "battle_id",
    "battle_repo",
    "battle_commit",
    "ran_at",
    "env",
    "tools",
    "runs",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Spec version, e.g. \"0.1.0\". Not the bench-kit version."
    },
    "battle_id": {
      "type": "string",
      "format": "uuid",
      "description": "KrabArena battle identifier."
    },
    "battle_repo": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical repository slug, e.g. \"github.com/keenableai/krabarena-bench\"."
    },
    "battle_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full git SHA-1 of the repo state used to produce this result."
    },
    "ran_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when the run started."
    },
    "env": {
      "$ref": "#/$defs/Env"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Tool" }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Run" }
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SummaryRow" },
      "description": "One row per (tool, task) pair, with aggregated metrics."
    }
  },
  "$defs": {
    "Env": {
      "type": "object",
      "required": [
        "os",
        "arch",
        "cpu_model",
        "cpu_count",
        "mem_total_mb",
        "docker_version",
        "kernel_version",
        "bench_kit_version",
        "runtime_hash",
        "hostname_redacted"
      ],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpu_model": { "type": "string", "minLength": 1 },
        "cpu_count": { "type": "integer", "minimum": 1 },
        "mem_total_mb": { "type": "integer", "minimum": 1 },
        "docker_version": { "type": "string", "minLength": 1 },
        "kernel_version": { "type": "string", "minLength": 1 },
        "bench_kit_version": { "type": "string", "minLength": 1 },
        "runtime_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "hostname_redacted": { "type": "boolean", "const": true }
      }
    },
    "Tool": {
      "type": "object",
      "required": ["name", "image_digest", "version", "runner_path"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "runner_path": {
          "type": "string",
          "pattern": "^runners/[a-z][a-z0-9_-]*\\.py$"
        }
      }
    },
    "Run": {
      "type": "object",
      "required": ["tool", "task", "iteration", "metrics", "success", "logs_path"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "task": { "type": "string" },
        "iteration": { "type": "integer", "minimum": 0 },
        "metrics": { "$ref": "#/$defs/Metrics" },
        "success": { "type": "boolean" },
        "logs_path": {
          "type": "string",
          "pattern": "^runs/[a-z][a-z0-9_/-]*$"
        }
      }
    },
    "Metrics": {
      "type": "object",
      "required": ["wall_clock_ms", "peak_rss_mb", "cpu_time_ms"],
      "properties": {
        "wall_clock_ms": { "type": "integer", "minimum": 0 },
        "peak_rss_mb": { "type": "integer", "minimum": 0 },
        "cpu_time_ms": { "type": "integer", "minimum": 0 },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 },
        "cost_cents": { "type": "number", "minimum": 0 },
        "requests_made": { "type": "integer", "minimum": 0 },
        "network_egress_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "SummaryRow": {
      "type": "object",
      "required": ["tool", "task", "metrics"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "task": { "type": "string" },
        "metrics": { "$ref": "#/$defs/SummaryMetrics" }
      }
    },
    "SummaryMetrics": {
      "type": "object",
      "required": ["success_rate"],
      "properties": {
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "wall_clock_ms_p50": { "type": "integer", "minimum": 0 },
        "wall_clock_ms_p95": { "type": "integer", "minimum": 0 },
        "wall_clock_ms_p99": { "type": "integer", "minimum": 0 },
        "peak_rss_mb": { "type": "integer", "minimum": 0 },
        "cpu_time_ms_p50": { "type": "integer", "minimum": 0 },
        "throughput": { "type": "number", "minimum": 0 },
        "tokens_in_total": { "type": "integer", "minimum": 0 },
        "tokens_out_total": { "type": "integer", "minimum": 0 },
        "cost_cents_total": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
